# Runtime data — never commit the DB, backups, or secrets (DR-6)
*.db
*.db-wal
*.db-shm
backups/
config.toml
# Everything Job Radar creates (settings + keys, database, Telegram login)
jobradar-data/
.env
# Auto-apply: the Telegram session is full access to your account; keep your
# résumé and the state file (application history, contacts) out of git too.
*.session
*.session-journal
resume.pdf
resume.txt
jobradar-state.json
jobradar-state.json.migrated
*.db.corrupt-*
# Dashboard: the session-cookie secret and the pre-dashboard config backup
jobradar-web.token
config.toml.bak

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# PyInstaller build output
build/
dist/
